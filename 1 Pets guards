	local function hook(ch)
		if ch:IsA("TextChannel") then
			track(ch.MessageReceived:Connect(function(m)
				local src = m.TextSource
				if src and src.UserId == LocalPlayer.UserId then onChat(m.Text) end
			end))
		end
	end
	for _, c in ipairs(chs:GetChildren()) do hook(c) end
	track(chs.ChildAdded:Connect(hook))
end)


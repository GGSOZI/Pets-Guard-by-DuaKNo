	HairAttachment = { "Head", CFrame.new(0, 0.6, 0) },
	FaceFrontAttachment = { "Head", CFrame.new(0, 0, -0.6) },
	FaceCenterAttachment = { "Head", CFrame.new(0, 0, 0) },
	NeckAttachment = { "Torso", CFrame.new(0, 1, 0) },
	BodyFrontAttachment = { "Torso", CFrame.new(0, 0, -0.5) },
	BodyBackAttachment = { "Torso", CFrame.new(0, 0, 0.5) },
	LeftCollarAttachment = { "Torso", CFrame.new(-1, 1, 0) },
	RightCollarAttachment = { "Torso", CFrame.new(1, 1, 0) },
	WaistFrontAttachment = { "Torso", CFrame.new(0, -1, -0.5) },
	WaistBackAttachment = { "Torso", CFrame.new(0, -1, 0.5) },
	WaistCenterAttachment = { "Torso", CFrame.new(0, -1, 0) },
}
local SLOT_ATT = { head = "HatAttachment", face = "FaceFrontAttachment", neck = "NeckAttachment", back = "BodyBackAttachment" }
local HEAD_ATT = { HatAttachment = true, HairAttachment = true, FaceFrontAttachment = true, FaceCenterAttachment = true }

local function loadAccessory(entry)
	if accTemplates[entry.id] then return accTemplates[entry.id] end
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(entry.id))
	end)
	if not ok or type(res) ~= "table" then return nil end
	local acc
	for _, o in ipairs(res) do
		if o:IsA("Accessory") then
			acc = o
			break
		end
		local inner = o:FindFirstChildWhichIsA("Accessory", true)
		if inner then
			acc = inner
			break
		end
	end
	if not acc or not acc:FindFirstChildWhichIsA("BasePart", true) then return nil end
	accTemplates[entry.id] = acc
	return acc
end

local function clearAccessories(p, group)
	if not p.acc then return end
	for key, list in pairs(p.acc) do
		if not group or key == group then
			for _, inst in ipairs(list) do
				pcall(function() inst:Destroy() end)
			end
			p.acc[key] = nil
		end
	end
end

local function scalePartBy(pt, f)
	pt.Size = pt.Size * f
	for _, c in ipairs(pt:GetChildren()) do
		if c:IsA("Attachment") then
			c.Position = c.Position * f
		elseif c:IsA("SpecialMesh") then
			c.Scale = c.Scale * f
			c.Offset = c.Offset * f
		elseif c:IsA("Weld") or c:IsA("ManualWeld") then
			c.C0 = CFrame.new(c.C0.Position * f) * (c.C0 - c.C0.Position)
			c.C1 = CFrame.new(c.C1.Position * f) * (c.C1 - c.C1.Position)
		end
	end
end

local function equipAccessory(p, entry)
	if p.isYuji or not (p.model and p.model.Parent) then return false end
	local acc = loadAccessory(entry)
	if not acc then return false end
	local clone = acc:Clone()
	local handle = clone:FindFirstChild("Handle") or clone:FindFirstChildWhichIsA("BasePart", true)
	if not handle then
		clone:Destroy()
		return false
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("Sound") or d.Name == "AccessoryWeld" then d:Destroy() end
	end

	local attName = SLOT_ATT[entry.slot] or "HatAttachment"
	for _, c in ipairs(handle:GetChildren()) do
		if c:IsA("Attachment") and R6_ATT[c.Name] then
			attName = c.Name
			break
		end
	end
	local group = HEAD_ATT[attName] and "head" or "back"

	local target, c0, sc
	if p.r6 then
		local info = R6_ATT[attName]
		target = p.model:FindFirstChild(info[1])
		sc = p.scaleK or 1
		c0 = CFrame.new(info[2].Position * sc)
	else
		local head = p.headPart or p.root
		local hs = math.max(head.Size.X, head.Size.Z)
		local front = Vector3.new(-math.sin(p.yaw), 0, -math.cos(p.yaw))
		local pos
		if group == "head" then
			target, sc = head, hs
			if attName == "FaceFrontAttachment" then
				pos = head.Position + front * (hs / 2)
			elseif attName == "FaceCenterAttachment" then
				pos = head.Position
			else
				pos = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
			end
		elseif attName == "NeckAttachment" then
			target, sc = head, hs
			pos = head.Position + Vector3.new(0, -head.Size.Y / 2, 0)
		else
			target = p.root
			sc = math.clamp(p.radius * 2 / 3.5, 0.3, 3)
			pos = p.root.Position + Vector3.new(0, (p.height or 2) * 0.2, 0) - front * (p.radius * 0.5)
		end
		if target then
			c0 = target.CFrame:ToObjectSpace(CFrame.new(pos) * CFrame.Angles(0, p.yaw, 0))
		end
	end
	if not target or not target.Parent then
		clone:Destroy()
		return false
	end

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then scalePartBy(d, sc) end
	end
	local a1 = CFrame.new()
	local att = handle:FindFirstChild(attName)
	if att and att:IsA("Attachment") then a1 = att.CFrame end

	clearAccessories(p, group)
	local parts = {}
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			d.Anchored = false
			table.insert(parts, d)
		end
	end
	local w = Instance.new("Weld")
	w.Name = "PetAccWeld"
	w.Part0 = target
	w.Part1 = handle
	w.C0 = c0
	w.C1 = a1
	for _, d in ipairs(parts) do d.Parent = p.model end
	w.Parent = handle
	clone:Destroy()
	p.acc = p.acc or {}
	p.acc[group] = parts
	if hiddenAll then
		for _, d in ipairs(parts) do d.LocalTransparencyModifier = 1 end
	end
	return true
end

local function giveAccessory(p, group)
	local pool = {}
	for _, e in ipairs(ACC_LIST) do
		local isBack = (e.slot == "back" or e.slot == "neck")
		if isBack == (group == "back") then table.insert(pool, e) end
	end
	for _ = 1, 5 do
		if not (p.model and p.model.Parent) then return false end
		local e = pool[math.random(1, #pool)]
		local ok, res = pcall(equipAccessory, p, e)
		if ok and res then return true end
	end
	return false
end

local function spawnPet(forced, slotWanted)
	if #pets >= CONFIG.MaxPets then
		notify("Guard", "All slots full. Use Recall or !swap.")
		return
	end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local entry, template
	local tried = {}
	if forced then
		if forced.kind == "yuji" then
			entry = forced
		else
			template = loadTemplate(forced)
			if template then entry = forced end
		end
	end
	for _ = 1, (entry and 0 or 5) do
		local cand = pickPet(tried)
		if not cand then break end
		tried[cand.id] = true
		if cand.kind == "yuji" then
			entry = cand
			break
		end
		template = loadTemplate(cand)
		if template then
			entry = cand
			break
		end
	end
	if entry and entry.kind == "yuji" then
		spawnYuji(entry, hrp, slotWanted)
		return
	end
	if not template then
		notify("Guard", "Couldn't load any pet model.")
		return
	end

	local m = template:Clone()
	if entry.toR6 then
		local okC, conv = pcall(convertR15ToR6, m)
		if okC and conv then m = conv end
	end
	local ids = classifyAnimations(harvestAnimations(m))

	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		end
	end

	local rootPart = chooseRoot(m)
	if not rootPart then
		m:Destroy()
		notify("Guard", "Model had no usable parts.")
		return
	end
	m.PrimaryPart = rootPart

	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.Massless = true
			d.Anchored = false
		end
	end
	rootPart.Anchored = true

	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function() hum.EvaluateStateMachine = false end)
		pcall(function() hum.WalkSpeed = 0 end)
		pcall(function() hum.BreakJointsOnDeath = false end)
		pcall(function() hum.RequiresNeck = false end)
		pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
		pcall(function() hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff end)
	end

	m.Parent = petFolder

	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= rootPart and d:GetRootPart() ~= rootPart then
			d.Anchored = true
		end
	end

	local minV, maxV = worldBounds(m)
	local span = maxV - minV
	local length = math.max(span.X, span.Z, 0.5)
	local k
	if entry.height then
		k = math.clamp(entry.height / math.max(span.Y, 0.5), 0.05, 20)
	else
		local want = (entry.kind == "cat") and CONFIG.CatLength or CONFIG.DogLength
		k = math.clamp(want / length, 0.05, 20)
	end
	pcall(function() m:ScaleTo(k) end)

	minV, maxV = worldBounds(m)
	span = maxV - minV
	local center = (minV + maxV) / 2
	local pivot = m:GetPivot()
	local bottom = pivot.Position.Y - minV.Y
	local nativeRot = pivot - pivot.Position
	local centerOff = Vector3.new(center.X - pivot.Position.X, 0, center.Z - pivot.Position.Z)

	local phi = 0
	local frontOk = false
	local frontPart
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = d.Name:lower()
			for _, hn in ipairs(HEAD_NAMES) do
				if n:find(hn, 1, true) then frontPart = d break end
			end
			if frontPart then break end
		end
	end
	if frontPart then
		local f = Vector3.new(frontPart.Position.X - center.X, 0, frontPart.Position.Z - center.Z)
		if f.Magnitude > math.max(span.X, span.Z) * 0.15 then
			phi = yawOf(f)
			frontOk = true
		end
	end

	local fvec = Vector3.new(-math.sin(phi), 0, -math.cos(phi))
	local limbs = buildLimbs(m, rootPart, center, minV, maxV, fvec)

	local isR6Rig = hum and m:FindFirstChild("Torso") and m:FindFirstChild("Left Leg")
	if entry.r6 then
		ids = R6_ANIMS
	elseif isR6Rig and not ids.walk then
		ids = R6_ANIMS
	end

	local animator
	if hum then
		animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
	else
		local ac = m:FindFirstChildWhichIsA("AnimationController", true)
		if not ac then
			ac = Instance.new("AnimationController")
			ac.Parent = m
		end
		animator = ac:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = ac
		end
	end
	local tracks = makeTracks(animator, ids)

	local slot = freeSlot(slotWanted)
	local startFlat = hrp.CFrame
	local look = startFlat.LookVector
	local yaw = yawOf(look)
	local flat = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
	local sp = flat:PointToWorldSpace(Vector3.new(SLOT_X[slot], 0, SLOT_Z[slot]))
	local gr = castWorld(Vector3.new(sp.X, sp.Y + 5, sp.Z), Vector3.new(0, -60, 0))
	local startY = gr and gr.Position.Y or (hrp.Position.Y - 3)

	local now = os.clock()
	local p = {
		entry = entry,
		kind = entry.kind,
		model = m,
		root = rootPart,
		slot = slot,
		pos = Vector3.new(sp.X, startY, sp.Z),
		yaw = yaw,
		vy = 0,
		grounded = true,
		speed = 0,
		state = "follow",
		target = nil,
		tracks = tracks,
		curTrack = nil,
		curKey = nil,
		nativeRot = nativeRot,
		phi = phi,
		bottom = bottom,
		centerOff = centerOff,
		radius = math.max(span.X, span.Z) / 2,
		lastBite = 0,
		alertAt = 0,
		hops = 0,
		nextScan = now + 0.5,
		nextRandom = now + math.random(CONFIG.RandomSoundMin, CONFIG.RandomSoundMax),
		nextPlay = now + math.random(8, 16),
		play = nil,
		nextFetchScan = now + 4,
		height = span.Y,
		roll = 0,
		pitch = 0,
		loaf = 0,
		frontOk = frontOk,
		nextZ = 0,
		fetch = nil,
		hp = CONFIG.PetMaxHp,
		hpShowUntil = 0,
		koUntil = 0,
		nextIdle = now + math.random(70, 130),
		order = nil,
		comeUntil = 0,
		hopAt = nil,
		limbs = limbs,
		amp = 0,
		air = 0,
		gaitT = 0,
	}
	local motors = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("Motor6D") and not motors[d.Name] then motors[d.Name] = d end
	end
	p.motors = motors
	p.r6 = (entry.r6 or isR6Rig) and motors["Right Shoulder"] and motors["Left Shoulder"]
		and motors["RootJoint"] and true or false
	p.scaleK = k
	p.headPart = frontPart or (p.r6 and m:FindFirstChild("Head")) or rootPart
	table.insert(pets, p)
	makeHpBar(p)
	makeFx(p)
	task.spawn(function()
		if math.random() < CONFIG.AccChance then giveAccessory(p, "head") end
		if math.random() < CONFIG.BackAccChance then giveAccessory(p, "back") end
	end)
	talk(p, "spawn")
	notify("Guard", "Spawned: " .. entry.label)
end


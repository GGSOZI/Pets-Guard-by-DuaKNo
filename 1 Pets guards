local function pickPet(exclude)
	local yuji
	local total = 0
	for _, e in ipairs(PET_LIST) do
		if e.kind == "yuji" then
			yuji = e
		elseif not exclude[e.id] then
			total += e.weight or 1
		end
	end
	if yuji and not exclude[yuji.id] then
		exclude[yuji.id] = true
		if math.random() < CONFIG.YujiChance then return yuji end
	end
	if total <= 0 then return nil end
	local r = math.random() * total
	for _, e in ipairs(PET_LIST) do
		if e.kind ~= "yuji" and not exclude[e.id] then
			r -= e.weight or 1
			if r <= 0 then return e end
		end
	end
	return nil
end


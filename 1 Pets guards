local function npcRoot(h)
	local m = h.Parent
	if not m then return nil end
	local r = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m.PrimaryPart
	if r and r:IsA("BasePart") then return r end
	return nil
end

local function validNpc(h)
	if not h or not h.Parent then return false end
	if h.Health <= 0 then return false end
	if h:GetState() == Enum.HumanoidStateType.Dead then return false end
	if not h:IsDescendantOf(Workspace) then return false end
	if h:IsDescendantOf(petFolder) then return false end
	local m = h.Parent
	if not m:IsA("Model") then return false end
	if Players:GetPlayerFromCharacter(m) then return false end
	return npcRoot(h) ~= nil
end

local function findTarget(p, playerPos, range, nameLike)
	local best, bestD = nil, math.huge
	range = range or (p.defend and CONFIG.DefendRange or CONFIG.ScanRange)
	for h in pairs(humanoids) do
		if validNpc(h) then
			local r = npcRoot(h)
			local okName = true
			if nameLike and nameLike ~= "" then
				local nm = (h.Parent and h.Parent.Name or ""):lower()
				local dn = (h.DisplayName or ""):lower()
				okName = nm:find(nameLike, 1, true) ~= nil or dn:find(nameLike, 1, true) ~= nil
			end
			if okName and (r.Position - playerPos).Magnitude <= range then
				local d = (r.Position - p.pos).Magnitude
				if d < bestD then best, bestD = h, d end
			end
		end
	end
	return best
end


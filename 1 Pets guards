local function itemOk(tool)
	if not tool.Parent or not tool:IsDescendantOf(Workspace) then return false end
	if tool:IsDescendantOf(petFolder) then return false end
	local h = tool:FindFirstChild("Handle")
	if not h or not h:IsA("BasePart") then return false end
	local par = tool.Parent
	if Players:GetPlayerFromCharacter(par) then return false end
	if par:IsA("Model") and par:FindFirstChildOfClass("Humanoid") then return false end
	return true
end

local function findItem(p, playerPos)
	local best, bestD = nil, math.huge
	for tool in pairs(itemSet) do
		if not claimedItems[tool] and itemOk(tool) then
			local h = tool.Handle
			if (h.Position - playerPos).Magnitude <= CONFIG.FetchRange then
				local d = (h.Position - p.pos).Magnitude
				if d < bestD then best, bestD = tool, d end
			end
		end
	end
	return best
end

local function releaseFetch(p)
	if p.fetch then
		if p.fetch.tool then claimedItems[p.fetch.tool] = nil end
		p.fetch = nil
	end
end

local function startFetch(p, tool, now)
	p.state = "fetch"
	p.fetch = { tool = tool, handle = tool.Handle, phase = "go", t0 = now, t1 = now }
	claimedItems[tool] = p
	if p.grounded then p.vy = 13 end
	playFor(p, "alert", 0.9)
	if talkOk(p, "found") then say(p, pick(DOG_FOUND)) end
end

local function deliverItem(p, ctx, now)
	local f = p.fetch
	if f then
		local h = f.handle
		local look = ctx.hrp.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if f.isPart then
			pcall(function()
				h.CFrame = CFrame.new(ctx.pos + flatLook * 3)
				h.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end)
		else
			pcall(function()
				h.CFrame = CFrame.new(ctx.pos + flatLook)
				h.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end)
			if firetouchinterest then
				pcall(function()
					firetouchinterest(ctx.hrp, h, 0)
					firetouchinterest(ctx.hrp, h, 1)
				end)
			end
		end
		if f.tool then claimedItems[f.tool] = nil end
	end
	p.fetch = nil
	p.state = "follow"
	p.nextFetchScan = now + CONFIG.FetchCooldown
	if p.grounded then p.vy = 12 end
	if f and f.isPart then
		talk(p, "gift", f.giftLabel)
	else
		if talkOk(p, "deliver") then say(p, pick(DOG_DELIVER)) end
	end
end


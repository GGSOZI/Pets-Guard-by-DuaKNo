local function worldBounds(model, includeHidden)
	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
	local count = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and (includeHidden or d.Transparency < 0.99) then
			local cf, s = d.CFrame, d.Size
			local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
			local ex = (math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z) / 2
			local ey = (math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z) / 2
			local ez = (math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z) / 2
			local p = cf.Position
			minV = Vector3.new(math.min(minV.X, p.X - ex), math.min(minV.Y, p.Y - ey), math.min(minV.Z, p.Z - ez))
			maxV = Vector3.new(math.max(maxV.X, p.X + ex), math.max(maxV.Y, p.Y + ey), math.max(maxV.Z, p.Z + ez))
			count += 1
		end
	end
	if count == 0 and not includeHidden then
		return worldBounds(model, true)
	end
	return minV, maxV
end

local function chooseRoot(m)
	local hrp = m:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then return hrp end
	if m.PrimaryPart then return m.PrimaryPart end
	local count, best, bestN = {}, nil, 0
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 then
			count[d.Part0] = (count[d.Part0] or 0) + 1
		end
	end
	for part, n in pairs(count) do
		if n > bestN then best, bestN = part, n end
	end
	if best then return best end
	local big, vol = nil, -1
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > vol then big, vol = d, v end
		end
	end
	return big
end

local function loadTemplate(entry)
	if templates[entry.id] then return templates[entry.id] end
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(entry.id))
	end)
	if not ok or type(res) ~= "table" or #res == 0 then return nil end
	local model
	for _, o in ipairs(res) do
		if o:IsA("Model") then
			model = o
			break
		elseif o:IsA("BasePart") then
			model = Instance.new("Model")
			o.Parent = model
			model.PrimaryPart = o
			break
		else
			local inner = o:FindFirstChildWhichIsA("Model", true)
			if inner then
				model = inner
				break
			end
			if o:IsA("Tool") or o:IsA("Accessory") then
				local wrap = Instance.new("Model")
				for _, c in ipairs(o:GetChildren()) do c.Parent = wrap end
				local handle = wrap:FindFirstChild("Handle") or wrap:FindFirstChildWhichIsA("BasePart", true)
				if handle then
					wrap.PrimaryPart = handle
					model = wrap
					break
				end
			end
		end
	end
	if not model then return nil end
	templates[entry.id] = model
	return model
end


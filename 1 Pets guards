local function talkOk(p, key)
	if key == "speak" or key == "spawn" then return true end
	local now = os.clock()
	if now < (p.nextTalk or 0) then return false end
	if math.random() > CONFIG.TalkChance then return false end
	p.nextTalk = now + CONFIG.TalkGap
	return true
end

local function talk(p, key, sub)
	if not talkOk(p, key) then return end
	local set = LINES[p.kind]
	local v = set and set[key]
	if v and sub then v = v[sub] end
	if v and #v > 0 then say(p, pick(v)) end
end


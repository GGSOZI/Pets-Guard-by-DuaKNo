local function castWorld(origin, dir)
	local filter = { petFolder }
	if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
	for _ = 1, 4 do
		rayParams.FilterDescendantsInstances = filter
		local r = Workspace:Raycast(origin, dir, rayParams)
		if not r then return nil end
		local mdl = r.Instance:FindFirstAncestorOfClass("Model")
		if mdl and mdl:FindFirstChildOfClass("Humanoid") then
			table.insert(filter, mdl)
		else
			return r
		end
	end
	return nil
end


local function chatChannel()
	if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local chs = TextChatService:FindFirstChild("TextChannels")
		return chs and chs:FindFirstChild("RBXGeneral")
	end
	return nil
end

local function sendChat(text)
	local ch = chatChannel()
	if ch then
		pcall(function() ch:SendAsync(text) end)
		return
	end
	pcall(function()
		local ev = svc("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		ev.SayMessageRequest:FireServer(text, "All")
	end)
end

local function systemMsg(text)
	local ch = chatChannel()
	if ch then
		pcall(function() ch:DisplaySystemMessage(text) end)
		return
	end
	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", { Text = text, Color = Color3.fromRGB(255, 210, 90) })
	end)
end

function ui.feedback(text)
	systemMsg(text)
	if ui.setStatus then ui.setStatus(text) end
end

local lastIntro = -100
local function introChat()
	if os.clock() - lastIntro < 20 then return end
	lastIntro = os.clock()
	if yujiHintDone then return end
	for _, p in ipairs(pets) do
		if p.isYuji then p.hintAt = os.clock() + 0.5 end
	end
end

local cmdToken = 0
local function showCommands()
	cmdToken += 1
	local mine = cmdToken
	task.spawn(function()
		for _, line in ipairs(CMD_LIST) do
			if mine ~= cmdToken then return end
			if CONFIG.CmdListAsPlayer then sendChat(line) else systemMsg(line) end
			task.wait(1.4)
		end
	end)
end

local function runCommand(cmd, arg)
	arg = arg or ""
	local now = os.clock()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local attacked = false
	for _, p in ipairs(pets) do
		if p.model and p.model.Parent then
			if cmd == "defend" then
				p.order = nil
				p.defend = true
				p.forceAtk = false
				p.comeUntil = now + 1.5
			elseif cmd == "follow" then
				releaseFetch(p)
				p.order = nil
				p.defend = false
				p.forceAtk = false
				p.play, p.target = nil, nil
				p.comeUntil = now + 1.5
				if p.isYuji then
					yujiAbort(p, now)
				elseif p.state ~= "ko" then
					p.state = "follow"
				end
			elseif cmd == "attack" or cmd == "target" then
				if hrp and p.state ~= "ko" then
					local hum = findTarget(p, hrp.Position, CONFIG.AttackRange, (cmd == "target") and arg:lower() or nil)
					if hum then
						releaseFetch(p)
						p.order = nil
						p.play = nil
						p.target = hum
						p.forceAtk = true
						p.hops = 0
						p.alertAt = now
						p.stateAt = now
						p.state = "alert"
						p.ycur = nil
						attacked = true
					end
				end
			elseif cmd == "sit" or cmd == "stay" then
				releaseFetch(p)
				p.play, p.target = nil, nil
				if p.isYuji then
					yujiAbort(p, now)
				elseif p.state ~= "ko" then
					p.state = "follow"
				end
				p.order = cmd
			elseif cmd == "come" then
				p.order = nil
				p.comeUntil = now + 2.5
				if not p.isYuji and (p.state == "play" or p.state == "fetch" or p.state == "sleep") then
					releaseFetch(p)
					p.play = nil
					p.state = "follow"
				end
			elseif cmd == "speak" then
				talk(p, "speak")
				if not p.isYuji then
					playFor(p, "random", 1)
					if p.grounded then p.vy = 10 end
				end
			elseif cmd == "roll" then
				if not p.isYuji and p.state ~= "ko" and p.state ~= "alert" and p.state ~= "attack" then
					releaseFetch(p)
					p.order = nil
					local kind = "spin"
					if p.kind == "dog" then kind = p.frontOk and "rollover" or "tailchase" end
					startPlay(p, now, kind)
				end
			end
		end
	end
	if (cmd == "attack" or cmd == "target") and not attacked then
		ui.feedback(cmd == "target" and "No NPC with that name nearby." or "No NPC found nearby.")
	elseif cmd == "attack" or cmd == "target" then
		ui.feedback("Pets are attacking!")
	elseif cmd == "defend" then
		ui.feedback("Pets are defending you.")
	elseif cmd == "follow" then
		ui.feedback("Pets are following you.")
	elseif cmd == "stay" or cmd == "sit" then
		ui.feedback("Pets are waiting. Use !follow to release them.")
	elseif cmd == "come" then
		ui.feedback("Pets are coming to you.")
	end
end

local function petBySlot(n)
	for _, p in ipairs(pets) do
		if p.slot == n then return p end
	end
	return nil
end

local function setPetName(p, name)
	p.name = name
	if p.nameGui then
		p.nameGui:Destroy()
		p.nameGui = nil
	end
	if not name or name == "" then return end
	local g = Instance.new("BillboardGui")
	g.Name = "PetName"
	g.Size = UDim2.new(5, 0, 0.7, 0)
	g.StudsOffset = Vector3.new(0, (p.height or 5) * 0.6 + 2.0, 0)
	g.AlwaysOnTop = true
	g.Adornee = p.root
	g.Parent = p.root
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.Text = name
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	l.Parent = g
	p.nameGui = g
end

local function removePet(p)
	if p.curTrack then pcall(function() p.curTrack:Stop(0) end) end
	releaseFetch(p)
	if p.model then pcall(function() p.model:Destroy() end) end
	for i, q in ipairs(pets) do
		if q == p then
			table.remove(pets, i)
			break
		end
	end
end

local function swapPet(slot, entry)
	if spawning then return end
	local old = slot and petBySlot(slot) or nil
	if not old and #pets >= CONFIG.MaxPets then old = pets[1] end
	if old then
		slot = old.slot
		removePet(old)
	end
	spawning = true
	local ok, err = pcall(spawnPet, entry, slot)
	spawning = false
	if not ok then warn("[Guard] " .. tostring(err)) end
end

local function runExtra(cmd, arg)
	local now = os.clock()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")

	if cmd == "list" then
		if #pets == 0 then
			ui.feedback("No pets out.")
			return
		end
		local lines = {}
		for _, p in ipairs(pets) do
			local hp = p.isYuji and 100 or math.floor(p.hp / CONFIG.PetMaxHp * 100 + 0.5)
			local nm = p.name and (' "' .. p.name .. '"') or ""
			table.insert(lines, p.slot .. ": " .. p.entry.label .. nm .. " - " .. hp .. "% hp" .. (p.state == "ko" and " (knocked out)" or ""))
		end
		for _, l in ipairs(lines) do systemMsg(l) end
		if ui.setStatus then ui.setStatus(table.concat(lines, "\n")) end
	elseif cmd == "heal" then
		for _, p in ipairs(pets) do
			if not p.isYuji and p.state ~= "ko" then
				p.hp = CONFIG.PetMaxHp
				p.hpShowUntil = now + 1.5
			end
		end
		ui.feedback("Pets healed.")
	elseif cmd == "revive" then
		local n = 0
		for _, p in ipairs(pets) do
			if p.state == "ko" then
				p.koUntil = 0
				n += 1
			end
		end
		ui.feedback(n > 0 and "Pets are getting back up." or "No pet is knocked out.")
	elseif cmd == "tp" then
		if not hrp then return end
		local look = hrp.CFrame.LookVector
		local yaw = yawOf(Vector3.new(look.X, 0, look.Z))
		local flat = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
		for _, p in ipairs(pets) do
			local sp = flat:PointToWorldSpace(Vector3.new(SLOT_X[p.slot], 0, SLOT_Z[p.slot]))
			local gr = castWorld(Vector3.new(sp.X, sp.Y + 5, sp.Z), Vector3.new(0, -60, 0))
			p.pos = Vector3.new(sp.X, gr and gr.Position.Y or (hrp.Position.Y - 3), sp.Z)
			p.vy = 0
		end
		ui.feedback("Pets teleported to you.")
	elseif cmd == "guard" then
		for _, p in ipairs(pets) do
			if p.state ~= "ko" then
				releaseFetch(p)
				p.play, p.target = nil, nil
				p.defend, p.forceAtk = false, false
				p.order = "guard"
				p.guardPos = p.pos
				if p.isYuji then
					yujiAbort(p, now)
				else
					p.state = "follow"
				end
			end
		end
		ui.feedback("Pets are guarding this spot.")
	elseif cmd == "hide" then
		hiddenAll = true
		ui.feedback("Pets hidden. Use !show to bring them back.")
	elseif cmd == "show" then
		hiddenAll = false
		ui.feedback("Pets visible again.")
	elseif cmd == "rename" then
		local sl, name = arg:match("^(%d)%s+(.+)$")
		if not sl then name = arg end
		name = (name or ""):sub(1, 20)
		if name == "" then
			ui.feedback("Usage: !rename [slot] name")
			return
		end
		local p = sl and petBySlot(tonumber(sl)) or pets[1]
		if not p then
			ui.feedback("No pet in that slot.")
			return
		end
		setPetName(p, name)
		ui.feedback(p.entry.label .. " is now called " .. name .. ".")
	elseif cmd == "hat" or cmd == "acc" then
		local group = (cmd == "hat") and "head" or "back"
		for _, p in ipairs(pets) do
			if not p.isYuji then task.spawn(giveAccessory, p, group) end
		end
		ui.feedback(cmd == "hat" and "New hats on the way." or "New accessories on the way.")
	elseif cmd == "nohat" then
		for _, p in ipairs(pets) do clearAccessories(p) end
		ui.feedback("Accessories removed.")
	elseif cmd == "swap" then
		local slotStr, rest = arg:match("^(%d)%s*(.*)$")
		local slot = slotStr and tonumber(slotStr) or nil
		local name = ((slotStr and rest) or arg):lower()
		local entry
		if name ~= "" then
			for _, e in ipairs(PET_LIST) do
				if e.label:lower():find(name, 1, true) then
					entry = e
					break
				end
			end
			if not entry then
				ui.feedback('No pet called "' .. name .. '".')
				return
			end
		end
		if slot and slot > CONFIG.MaxPets then slot = nil end
		ui.feedback("Swapping pet...")
		task.spawn(swapPet, slot, entry)
	end
end

local EXTRA = {
	heal = true, revive = true, tp = true, guard = true, hide = true, show = true,
	rename = true, list = true, swap = true, hat = true, acc = true, nohat = true,
}
local BASIC = {
	sit = true, stay = true, come = true, speak = true, roll = true,
	defend = true, attack = true, follow = true, target = true,
}

local function execCmd(cmd, arg)
	arg = arg or ""
	if cmd == "cmds" then
		showCommands()
	elseif EXTRA[cmd] then
		runExtra(cmd, arg)
	elseif BASIC[cmd] then
		runCommand(cmd, arg)
	end
end

local lastCmd, lastCmdAt = nil, 0
local function onChat(msg)
	if type(msg) ~= "string" then return end
	local c, arg = msg:match("^%s*!(%a+)%s*(.-)%s*$")
	if not c then return end
	local cmd = c:lower()
	if not (cmd == "cmds" or EXTRA[cmd] or BASIC[cmd]) then return end
	local now = os.clock()
	local key = cmd .. "|" .. arg
	if key == lastCmd and now - lastCmdAt < 0.7 then return end
	lastCmd, lastCmdAt = key, now
	execCmd(cmd, arg)
end


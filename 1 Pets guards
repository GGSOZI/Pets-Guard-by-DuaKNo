end

local function damagePet(p, dmg, now)
	if p.isYuji or p.state == "ko" then return end
	p.hp = math.max(0, p.hp - dmg)
	p.hpShowUntil = now + CONFIG.ShowHpTime
	if p.hp <= 0 then
		releaseFetch(p)
		p.state = "ko"
		p.koUntil = now + CONFIG.KoTime
		p.target = nil
		p.play = nil
		p.order = nil
		talk(p, "ko")
		return
	end
	talk(p, "hurt")
	playFor(p, p.kind == "cat" and "alert" or "random", 0.7)
	if p.hp < CONFIG.PetMaxHp * CONFIG.HurtFleeFrac and (p.state == "attack" or p.state == "alert") then
		p.state = "follow"
		p.target = nil
		p.nextScan = now + 4
		talk(p, "retreat")
	end
end

local function pickGiftPart(model)
	if not model then return nil end
	local want = pick({ "head", "leg", "torso" })
	local found = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			local n = d.Name:lower()
			if (want == "head" and n == "head")
				or (want == "leg" and n:find("leg", 1, true))
				or (want == "torso" and (n == "torso" or n == "uppertorso" or n == "lowertorso")) then
				table.insert(found, d)
			end
		end
	end
	if #found == 0 then return nil end
	return pick(found), want
end

local function startGift(p, part, label, now)
	p.fetch = { part = part, handle = part, isPart = true, giftLabel = label, phase = "go", t0 = now, t1 = now }
	p.state = "fetch"
	p.target = nil
	if p.grounded then p.vy = 10 end
end

local function recallPet()
	local p = table.remove(pets, 1)
	if not p then
		notify("Recall", "No pets out.")
		return
	end
	if p.curTrack then pcall(function() p.curTrack:Stop(0) end) end
	releaseFetch(p)
	if p.model then p.model:Destroy() end
	notify("Recall", "Recalled: " .. p.entry.label)
end

local function petCleave(p, primary, radius, minDmg, frac, kb, up, pitch)
	local list = cleaveTargets(p, primary, radius)
	local died, model = false, nil
	for _, hum in ipairs(list) do
		local r = npcRoot(hum)
		if r then
			local push = Vector3.new(r.Position.X - p.pos.X, 0, r.Position.Z - p.pos.Z)
			push = (push.Magnitude > 0.01) and push.Unit or Vector3.new(0, 0, -1)
			if pitch then ySound(r, YUJI.HitSound, 1, pitch, 1.5) end
			local dmg = math.max(minDmg, hum.MaxHealth * frac)
			pcall(function() hum.Health = math.max(0, hum.Health - dmg) end)
			pcall(function() r.AssemblyLinearVelocity = push * kb + Vector3.new(0, up, 0) end)
			if hum.Health <= 0 then
				local m = hum.Parent
				killNpc(hum)
				if hum == primary then
					died, model = true, m
				end
			end
		end
	end
	return died, model
end

local function petAfterKill(p, model, now)
	playFor(p, "kill", 0.9)
	talk(p, "kill")
	p.m1busy = false
	p.ycur = nil
	p.special = nil
	if chainNext(p, now) then return end
	p.target = nil
	p.state = "follow"
	p.nextScan = now + 0.6
	if math.random() < CONFIG.GiftChance then
		local part, label = pickGiftPart(model)
		if part then startGift(p, part, label, now) end
	end
end

local function biteTarget(p, now)
	local hum = p.target
	if not validNpc(hum) then return end
	p.lastBite = now
	claimOwnership()
	if p.tracks.attack then p.tracks.attack:Play() end
	p.vy = 12
	local died, model = petCleave(p, hum, CONFIG.CleaveRadius * 0.7, CONFIG.BiteDamage, 0.12, 28, 14, nil)
	if died then
		petAfterKill(p, model, now)
	elseif math.random() < CONFIG.RetaliateChance then
		damagePet(p, math.random(CONFIG.RetaliateMin, CONFIG.RetaliateMax), now)
	end
end

local function petM1Hit(p, idx)
	local hum = p.target
	if not validNpc(hum) then return end
	claimOwnership()
	local now = os.clock()
	local last = idx >= 3
	local died, model = petCleave(p, hum, CONFIG.CleaveRadius, YUJI.M1Damage,
		last and 0.1 or 0.06, last and 34 or 14, last and 14 or 6, 0.8 + idx * 0.08)
	if died then
		petAfterKill(p, model, now)
	elseif last and math.random() < CONFIG.RetaliateChance then
		damagePet(p, math.random(CONFIG.RetaliateMin, CONFIG.RetaliateMax), now)
	end
end

local function petM1(p, idx, now)
	p.m1busy = true
	p.m1 = idx
	p.lastBite = now
	for _, t in pairs(p.tracks) do
		pcall(function() if t.IsPlaying then t:Stop(0.05) end end)
	end
	p.curTrack, p.curKey = nil, nil
	local cur = yPlay(p, "Punch" .. idx, function()
		if not p.m1busy or p.m1 ~= idx then return end
		if idx < 3 and p.state == "attack" and validNpc(p.target) then
			petM1(p, idx + 1, os.clock())
		else
			p.m1busy = false
			p.lastBite = os.clock()
		end
	end)
	if not cur then
		p.m1busy = false
		return
	end
	task.delay(YUJI.M1Hit[idx], function()
		if p.ycur == cur and p.m1busy and p.state == "attack" then petM1Hit(p, idx) end
	end)
end

local function petSpecialHit(p, kind, now)
	local hum = p.target
	if not validNpc(hum) then return end
	claimOwnership()
	local minDmg, frac, kb, up
	if kind == "pounce" then
		minDmg, frac, kb, up = CONFIG.BiteDamage * 1.5, 0.2, 22, 18
	else
		minDmg, frac, kb, up = CONFIG.BiteDamage * 1.8, 0.25, 62, 24
	end
	playFor(p, "alert", 0.9)
	local died, model = petCleave(p, hum, CONFIG.CleaveRadius, minDmg, frac, kb, up, 0.9)
	if died then petAfterKill(p, model, now) end
end

chainNext = function(p, now)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum
	if p.order == "guard" and p.guardPos then
		hum = findTarget(p, p.guardPos, CONFIG.GuardRange)
	elseif p.defend then
		hum = hrp and findTarget(p, hrp.Position, CONFIG.DefendRange)
	else
		hum = findTarget(p, p.pos, CONFIG.ChainRange)
		if hum then p.forceAtk = true end
	end
	if not hum then return false end
	p.target = hum
	p.m1busy = false
	p.ycur = nil
	p.special = nil
	if p.isYuji then
		p.state = "run"
		p.stateAt = now
		yPlay(p, "Run", nil, 1.9)
	else
		p.state = "attack"
		p.alertAt = now
		p.hops = 0
	end
	return true
end

local function steer(p, dir, speed)
	local probe = math.clamp(speed * 0.3, 2.5, 7) + p.radius
	local origin = Vector3.new(p.pos.X, p.pos.Y + 3.3, p.pos.Z)
	if not castWorld(origin, dir * probe) then return dir end
	for _, ang in ipairs({ 0.6, -0.6, 1.2, -1.2, 1.9, -1.9 }) do
		local d2 = CFrame.Angles(0, ang, 0):VectorToWorldSpace(dir)
		if not castWorld(origin, d2 * probe) then return d2 end
	end
	return nil
end

local function orbitGoal(p, ctx, radius, dir, lead)
	local a = math.atan2(p.pos.Z - ctx.pos.Z, p.pos.X - ctx.pos.X) + dir * lead
	return Vector3.new(ctx.pos.X + math.cos(a) * radius, p.pos.Y, ctx.pos.Z + math.sin(a) * radius)
end

local function startPlay(p, now, forced)
	local kinds = { "circle", "pounce", "scratch" }
	if p.kind == "dog" then
		kinds = { "zoomies", "tailchase" }
		if p.frontOk then
			table.insert(kinds, "rollover")
			table.insert(kinds, "beg")
		end
	end
	local kind = forced or pick(kinds)
	local durs = { circle = 3.4, pounce = 2.4, scratch = 3, zoomies = 4, tailchase = 2.6, rollover = 3.4, beg = 3, spin = 2.4 }
	p.state = "play"
	p.play = {
		kind = kind,
		t0 = now,
		dur = durs[kind],
		ang = math.random() * math.pi * 2,
		dir = (math.random() < 0.5) and 1 or -1,
		hops = 0,
		lastHop = 0,
		scratching = false,
	}
	talk(p, "play", kind)
end

local function stepPet(p, dt, now, ctx)
	local goal, stop, cap, fixed, faceTarget
	local spin, directRoll, pitchTarget, sleeping, sitting

	if p.m1busy and p.state ~= "attack" then
		p.m1busy = false
		p.ycur = nil
	end
	if p.state == "follow" then p.forceAtk = false end
	if p.special and p.state ~= "attack" then
		p.special = nil
		p.specialReadyAt = now + 3
	end

	if p.state ~= "attack" and p.state ~= "alert" then
		local rate = (p.state == "sleep" or p.state == "ko") and CONFIG.SleepRegen or CONFIG.PetRegen
		p.hp = math.min(CONFIG.PetMaxHp, p.hp + rate * dt)
	end

	local st0 = p.state
	if (st0 == "follow" or st0 == "play" or st0 == "fetch" or st0 == "sleep") and (not p.order or p.order == "guard")
		and p.hp >= CONFIG.PetMaxHp * CONFIG.HurtFleeFrac then
		if now >= p.nextScan then
			p.nextScan = now + 0.3
			local hum = findTarget(p, (p.order == "guard" and p.guardPos) or ctx.pos, (p.order == "guard") and CONFIG.GuardRange or nil)
			if hum then
				if st0 == "fetch" then releaseFetch(p) end
				p.play = nil
				p.target = hum
				p.state = "alert"
				p.alertAt = now
				p.hops = 0
				playFor(p, "alert", 0.8)
				talk(p, "alert")
			end
		end
	end

	if p.state == "follow" then
		local x = SLOT_X[p.slot] * (1 - 0.55 * ctx.tuck)
		local z = SLOT_Z[p.slot] + 2.2 * ctx.tuck
		goal = ctx.flat:PointToWorldSpace(Vector3.new(x, 0, z))
		stop, cap = 0.6, CONFIG.FollowSpeedMax
		if p.order == "guard" then
			goal, stop = p.guardPos, 1.5
		elseif p.order then
			goal = nil
			sitting = (p.order == "sit")
		elseif now < p.comeUntil then
			cap, fixed, stop = CONFIG.FollowSpeedMax * 1.6, true, 1.5
		end

		if now >= p.nextRandom and now - lastRandomAny >= CONFIG.GlobalSoundGap then
			lastRandomAny = now
			p.nextRandom = now + math.random(CONFIG.RandomSoundMin, CONFIG.RandomSoundMax)
			playFor(p, "random", 0.5)
		end

		if p.kind == "cat" and now >= p.nextIdle then
			p.nextIdle = now + math.random(90, 160)
			talk(p, "idle")
		end

		if p.kind == "dog" and not p.order and now >= p.nextFetchScan then
			p.nextFetchScan = now + 0.7
			local tool = findItem(p, ctx.pos)
			if tool then startFetch(p, tool, now) end
		end

		if p.state == "follow" and not p.order and (p.kind == "cat" or p.kind == "dog") and now >= p.nextPlay then
			p.nextPlay = now + math.random(CONFIG.PlayMin, CONFIG.PlayMax)
			startPlay(p, now)
		end

		if p.state == "follow" and not p.order and ctx.still >= CONFIG.SleepAfter then
			p.state = "sleep"
			p.nextZ = now + 5
		end
	elseif p.state == "play" then
		local pl = p.play
		if not pl or now - pl.t0 >= pl.dur then
			p.state, p.play = "follow", nil
			p.nextPlay = now + math.random(CONFIG.PlayMin, CONFIG.PlayMax)
		elseif pl.kind == "circle" then
			goal = orbitGoal(p, ctx, 5.5, pl.dir, 0.7)
			stop, cap, fixed = 0.3, 20, true
		elseif pl.kind == "pounce" then
			local front = ctx.flat:PointToWorldSpace(Vector3.new(0, 0, -4.5))
			goal, stop, cap, fixed = front, 0.8, 26, true
			faceTarget = ctx.pos
			local d = Vector3.new(front.X - p.pos.X, 0, front.Z - p.pos.Z).Magnitude
			if d < 2 and p.grounded and pl.hops < 3 and now - pl.lastHop > 0.5 then
				p.vy = 18
				pl.hops += 1
				pl.lastHop = now
				if pl.hops == 1 then playFor(p, "random", 0.7) end
			end
		elseif pl.kind == "scratch" then
			local front = ctx.flat:PointToWorldSpace(Vector3.new(0, 0, -2.4))
			goal, stop, cap, fixed = front, 0.4, 22, true
			faceTarget = ctx.pos
			local d = Vector3.new(front.X - p.pos.X, 0, front.Z - p.pos.Z).Magnitude
			if d < 1.2 then
				pl.scratching = true
				if p.grounded and now - pl.lastHop > 0.3 then
					p.vy = 7
					pl.lastHop = now
					if p.tracks.attack then p.tracks.attack:Play() end
				end
			end
		elseif pl.kind == "zoomies" then
			goal = orbitGoal(p, ctx, 7, pl.dir, 0.8)
			stop, cap, fixed = 0.3, 32, true
			if p.grounded and now - pl.lastHop > 0.9 then
				p.vy = 11
				pl.lastHop = now
				playFor(p, "random", 0.6)
			end
		elseif pl.kind == "tailchase" or pl.kind == "spin" then
			spin = ((pl.kind == "spin") and 9 or 11) * pl.dir
			pl.fake = 12
		elseif pl.kind == "rollover" then
			local side = ctx.flat:PointToWorldSpace(Vector3.new(SLOT_X[p.slot] * 0.6, 0, -1.5))
			if not pl.rolling then
				goal, stop, cap, fixed = side, 0.5, 24, true
				faceTarget = ctx.pos
				local d = Vector3.new(side.X - p.pos.X, 0, side.Z - p.pos.Z).Magnitude
				if d < 1.2 then
					pl.rolling = true
					pl.rollStart = now
					pl.t0 = now
					pl.dur = 1.9
				end
			else
				directRoll = math.clamp((now - pl.rollStart) / 1.6, 0, 1) * math.pi * 2
				pl.fake = 0
			end
		elseif pl.kind == "beg" then
			local front = ctx.flat:PointToWorldSpace(Vector3.new(0, 0, -3.2))
			goal, stop, cap, fixed = front, 0.4, 22, true
			faceTarget = ctx.pos
			local d = Vector3.new(front.X - p.pos.X, 0, front.Z - p.pos.Z).Magnitude
			if d < 1.2 then
				pitchTarget = 0.8
				if p.grounded and now - pl.lastHop > 0.7 then
					p.vy = 6
					pl.lastHop = now
				end
			end
		end
	elseif p.state == "sleep" then
		if ctx.still < 1 then
			p.state = "follow"
			p.nextPlay = now + math.random(CONFIG.PlayMin, CONFIG.PlayMax)
			p.nextFetchScan = now + 3
			if math.random() < 0.7 then talk(p, "wake") end
		else
			sleeping = true
			goal = ctx.flat:PointToWorldSpace(Vector3.new(SLOT_X[p.slot], 0, SLOT_Z[p.slot]))
			stop, cap = 0.6, CONFIG.FollowSpeedMax
			if now >= p.nextZ then
				p.nextZ = now + 7 + math.random() * 3
				talk(p, "sleep")
			end
		end
	elseif p.state == "ko" then
		sleeping = true
		if now >= p.koUntil then
			p.hp = math.max(p.hp, CONFIG.PetMaxHp * 0.4)
			p.hpShowUntil = now + CONFIG.ShowHpTime
			p.state = "follow"
			p.nextScan = now + 2
			talk(p, "revive")
		end
	elseif p.state == "fetch" then
		local f = p.fetch
		local valid = f and ((f.isPart and f.part.Parent ~= nil and f.part:IsDescendantOf(Workspace))
			or (f.tool and itemOk(f.tool)))
		if not valid then
			releaseFetch(p)
			p.state = "follow"
			p.nextFetchScan = now + 3
			if p.kind == "dog" and not (f and f.isPart) then if talkOk(p, "lost") then say(p, pick(DOG_LOST)) end end
		else
			local h = f.handle
			if f.phase == "go" then
				goal, stop, cap, fixed = h.Position, 2.2 + p.radius * 0.3, CONFIG.FetchSpeed, true
				faceTarget = h.Position
				local d = Vector3.new(h.Position.X - p.pos.X, 0, h.Position.Z - p.pos.Z).Magnitude
				if d <= stop + 1.2 then
					f.phase = "back"
					f.t1 = now
					claimOwnership()
				elseif now - f.t0 > 14 then
					releaseFetch(p)
					p.state = "follow"
					p.nextFetchScan = now + 3
				end
			else
				goal, stop, cap, fixed = ctx.pos, 3.2, CONFIG.FetchSpeed, true
				local fwd = Vector3.new(-math.sin(p.yaw), 0, -math.cos(p.yaw))
				local mouth = p.pos + fwd * (p.radius * 0.9) + Vector3.new(0, p.height * 0.45, 0)
				pcall(function()
					h.CFrame = CFrame.new(mouth)
					h.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					h.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				end)
				local d = Vector3.new(ctx.pos.X - p.pos.X, 0, ctx.pos.Z - p.pos.Z).Magnitude
				if d <= 4.5 or now - f.t1 > 15 then deliverItem(p, ctx, now) end
			end
		end
	elseif p.state == "alert" then
		local tr = validNpc(p.target) and npcRoot(p.target)
		if not tr then
			p.state, p.target = "follow", nil
		else
			faceTarget = tr.Position
			if p.hops < 2 and p.grounded and now - p.alertAt >= p.hops * 0.5 then
				p.vy = 17
				p.hops += 1
			end
			if now - p.alertAt >= 1.1 then p.state = "attack" end
		end
	elseif p.state == "attack" then
		local tr = validNpc(p.target) and npcRoot(p.target)
		local limit = p.forceAtk and (CONFIG.AttackRange + 20)
			or (p.order == "guard" and CONFIG.GuardRange + 10)
			or (p.defend and CONFIG.DefendRange + 8) or CONFIG.ChaseLimit
		local anchor = (p.order == "guard" and p.guardPos) or ctx.pos
		if not tr and chainNext(p, now) then
			goal = nil
		elseif not tr or (tr.Position - anchor).Magnitude > limit then
			p.state, p.target = "follow", nil
			p.nextScan = now + 0.5
		else
			goal, stop, cap = tr.Position, 2.5 + p.radius * 0.3, CONFIG.AttackSpeed
			faceTarget = tr.Position
			local d = Vector3.new(tr.Position.X - p.pos.X, 0, tr.Position.Z - p.pos.Z).Magnitude
			if not p.r6 and not p.special and (p.kind == "cat" or p.kind == "dog")
				and now >= (p.specialReadyAt or 0) and p.grounded and d >= 6 and d <= 20 then
				p.special = (p.kind == "cat") and "pounce" or "charge"
				p.specialUntil = now + ((p.special == "pounce") and 0.7 or 0.65)
				p.specialHit = false
				if p.special == "pounce" then p.vy = 30 end
				if p.tracks.attack then p.tracks.attack:Play() end
				playFor(p, "alert", 0.9)
			end
			if p.special then
				local spd = (p.special == "pounce") and 42 or 78
				goal, stop, cap, fixed = tr.Position, 1.0, spd, true
				if not p.specialHit and d <= CONFIG.BiteRange + p.radius + 0.8 then
					p.specialHit = true
					petSpecialHit(p, p.special, now)
				end
				if p.special and now >= p.specialUntil then
					p.specialReadyAt = now + ((p.special == "pounce") and CONFIG.PounceCooldown or CONFIG.ChargeCooldown)
					p.special = nil
				end
			end
			if not p.special and d <= CONFIG.BiteRange + p.radius and now - p.lastBite >= CONFIG.BiteCooldown then
				if p.r6 then
					if not p.m1busy then petM1(p, 1, now) end
				else
					biteTarget(p, now)
				end
			end
			if p.m1busy then goal = nil end
		end
	end

	local speed, moveDir = 0, nil
	if goal then
		local to = Vector3.new(goal.X - p.pos.X, 0, goal.Z - p.pos.Z)
		local dist = to.Magnitude
		if dist > 90 and p.state == "follow" then
			p.pos = Vector3.new(goal.X, p.pos.Y, goal.Z)
			dist = 0
		end
		if dist > stop then
			local dir = to / dist
			speed = (p.state == "attack" or fixed) and cap or math.clamp((dist - stop) * 4, 0, cap)
			dir = steer(p, dir, speed)
			if dir then
				moveDir = dir
				p.pos = p.pos + dir * speed * dt
			else
				speed = 0
			end
		end
	end
	p.speed = speed

	if p.hopAt and now >= p.hopAt then
		if p.grounded then p.vy = 20 end
		p.hopAt = nil
	end
	local gr = castWorld(Vector3.new(p.pos.X, p.pos.Y + 4, p.pos.Z), Vector3.new(0, -80, 0))
	local gY = gr and gr.Position.Y or ctx.feetY
	p.vy = p.vy - 95 * dt
	local y = p.pos.Y + p.vy * dt
	if y <= gY + 0.05 and p.vy <= 0 then
		y = gY
		p.vy = 0
		p.grounded = true
	else
		p.grounded = false
	end
	p.pos = Vector3.new(p.pos.X, y, p.pos.Z)

	local desired
	if faceTarget then
		local v = faceTarget - p.pos
		desired = yawOf(Vector3.new(v.X, 0, v.Z))
	elseif moveDir and speed > 1.5 then
		desired = yawOf(moveDir)
	else
		desired = ctx.yaw
	end
	if p.state == "play" and p.play and p.play.scratching then
		desired = desired + math.sin(now * 24) * 0.4
	end
	if spin then
		p.yaw = p.yaw + spin * dt
	else
		p.yaw = lerpAngle(p.yaw, desired, math.clamp(dt * 12, 0, 1))
	end

	if p.state == "play" and p.play and (p.play.scratching or p.play.fake) then
		speed = p.play.fake or 14
	end

	local lying = sleeping and p.speed < 0.5
	local seated = sitting and p.speed < 0.5
	local rollGoal = (lying and p.frontOk) and math.pi / 2 or 0
	local loafGoal = ((lying or seated) and not p.frontOk) and 1 or 0
	p.loaf = p.loaf + (loafGoal - p.loaf) * math.clamp(dt * 5, 0, 1)
	if seated and p.frontOk then pitchTarget = 0.55 end
	if directRoll then
		p.roll = directRoll
	else
		p.roll = p.roll % (2 * math.pi)
		p.roll = p.roll + (rollGoal - p.roll) * math.clamp(dt * 5, 0, 1)
	end
	p.pitch = p.pitch + ((pitchTarget or 0) - p.pitch) * math.clamp(dt * 8, 0, 1)

	local key
	if not p.grounded then
		key = "jump"
	elseif speed > 13 then
		key = "run"
	elseif speed > 0.8 then
		key = "walk"
	else
		key = "idle"
	end
	if p.m1busy and p.r6 then
		yStep(p, dt)
	else
		setAnim(p, key)
	end
	if p.curTrack and (key == "walk" or key == "run") then
		local base = (key == "run" and not p.tracks.run) and 1.6 or 1
		p.curTrack:AdjustSpeed(base * math.clamp(speed / 10, 0.7, 1.5))
	end

	local bob = 0
	if not p.tracks.walk then
		if #p.limbs > 0 then
			bob = animateLimbs(p, now, dt, speed)
		elseif speed > 0.8 and p.grounded then
			bob = math.abs(math.sin(now * 14)) * 0.25 * (0.5 + speed / 30)
		end
	end

	local rot = CFrame.Angles(0, p.yaw - p.phi, 0)
	local off = rot:VectorToWorldSpace(p.centerOff)
	local lift = p.bottom * (1 - 0.4 * math.abs(math.sin(p.roll))) * (1 - 0.28 * p.loaf)
	local cf = CFrame.new(p.pos.X - off.X, p.pos.Y + lift + bob, p.pos.Z - off.Z) * rot * CFrame.Angles(p.pitch, 0, p.roll) * p.nativeRot
	p.model:PivotTo(cf)
	updateHpBar(p, now)
end

local function stepYuji(p, dt, now, ctx)
	local goal, stop, cap, fixed, faceTarget

	if p.hintAt and now >= p.hintAt then
		p.hintAt = nil
		if not yujiHintDone then
			yujiHintDone = true
			say(p, "type !cmds to see all commands")
		end
	end
	if p.state == "follow" then p.forceAtk = false end

	if p.state == "follow" and (not p.order or p.order == "guard") and now >= p.nextScan then
		p.nextScan = now + 0.3
		local hum = findTarget(p, (p.order == "guard" and p.guardPos) or ctx.pos, (p.order == "guard") and CONFIG.GuardRange or nil)
		if hum then
			p.target = hum
			p.state = "alert"
			p.stateAt = now
			p.ycur = nil
			playSound(p.root, pick(SOUNDS.cat.alert), 0.9)
		end
	end

	local tr
	if p.state ~= "follow" and p.state ~= "flash" then
		tr = validNpc(p.target) and npcRoot(p.target)
		if not tr then
			if chainNext(p, now) then tr = validNpc(p.target) and npcRoot(p.target) end
			if not tr then yujiAbort(p, now) end
		end
	end
	local d = 0
	if tr then
		d = Vector3.new(tr.Position.X - p.pos.X, 0, tr.Position.Z - p.pos.Z).Magnitude
	end

	if p.state == "follow" then
		local x = SLOT_X[p.slot] * (1 - 0.55 * ctx.tuck)
		local z = SLOT_Z[p.slot] + 2.2 * ctx.tuck
		goal = ctx.flat:PointToWorldSpace(Vector3.new(x, 0, z))
		stop, cap = 0.6, CONFIG.FollowSpeedMax
		if p.order == "guard" then
			goal, stop = p.guardPos, 1.5
		elseif p.order then
			goal = nil
		end
	elseif p.state == "alert" then
		faceTarget = tr.Position
		if now - p.stateAt >= YUJI.AlertTime then
			p.state = "dash"
			p.stateAt = now
			yPlay(p, "Dash")
		end
	elseif p.state == "dash" then
		faceTarget = tr.Position
		goal, stop, cap, fixed = tr.Position, 5, YUJI.DashSpeed, true
		if now - p.stateAt >= YUJI.DashTime or d <= 6 then
			p.state = "run"
			p.stateAt = now
			yPlay(p, "Run", nil, 1.9)
		end
	elseif p.state == "run" then
		faceTarget = tr.Position
		goal, stop, cap, fixed = tr.Position, YUJI.StopDist, YUJI.RunSpeed, true
		if not p.ycur or p.ycur.name ~= "Run" then yPlay(p, "Run", nil, 1.9) end
		if d <= YUJI.MeleeDist then
			yujiPunch(p, 1, now)
		elseif now - p.stateAt > 6 then
			yujiAbort(p, now)
		end
	elseif p.state == "m1" then
		faceTarget = tr.Position
		if d > YUJI.MeleeDist then
			goal, stop, cap, fixed = tr.Position, YUJI.StopDist, 18, true
		end
	elseif p.state == "flash" then
		local t2 = validNpc(p.target) and npcRoot(p.target)
		if t2 then p.lastTargetPos = t2.Position end
		faceTarget = p.lastTargetPos
	end

	local speed, moveDir = 0, nil
	if goal then
		local to = Vector3.new(goal.X - p.pos.X, 0, goal.Z - p.pos.Z)
		local dist = to.Magnitude
		if dist > 90 and p.state == "follow" then
			p.pos = Vector3.new(goal.X, p.pos.Y, goal.Z)
			dist = 0
		end
		if dist > stop then
			local dir = to / dist
			speed = fixed and cap or math.clamp((dist - stop) * 4, 0, cap)
			dir = steer(p, dir, speed)
			if dir then
				moveDir = dir
				p.pos = p.pos + dir * speed * dt
			else
				speed = 0
			end
		end
	end
	p.speed = speed

	local gr = castWorld(Vector3.new(p.pos.X, p.pos.Y + 4, p.pos.Z), Vector3.new(0, -80, 0))
	local gY = gr and gr.Position.Y or ctx.feetY
	p.vy = p.vy - 95 * dt
	local y = p.pos.Y + p.vy * dt
	if y <= gY + 0.05 and p.vy <= 0 then
		y = gY
		p.vy = 0
		p.grounded = true
	else
		p.grounded = false
	end
	p.pos = Vector3.new(p.pos.X, y, p.pos.Z)

	local desired
	if faceTarget then
		local v = faceTarget - p.pos
		desired = yawOf(Vector3.new(v.X, 0, v.Z))
	elseif moveDir and speed > 1.5 then
		desired = yawOf(moveDir)
	else
		desired = ctx.yaw
	end
	p.yaw = lerpAngle(p.yaw, desired, math.clamp(dt * 14, 0, 1))

	if p.state == "follow" then
		if speed > 3 then
			if not p.ycur or p.ycur.name ~= "Run" then
				yPlay(p, "Run", nil, math.clamp(speed / 16, 0.6, 2))
			end
		elseif p.ycur and p.ycur.name == "Run" then
			p.ycur = nil
		end
	end
	if p.ycur and p.ycur.name == "Run" and p.state ~= "run" then
		p.ycur.walkScale = math.clamp(speed / 16, 0.6, 2)
	elseif p.ycur and p.ycur.name == "Run" then
		p.ycur.walkScale = math.clamp(math.max(speed, 16) / 16, 0.6, 2)
	end
	yStep(p, dt)

	local rot = CFrame.Angles(0, p.yaw, 0)
	p.model:PivotTo(CFrame.new(p.pos.X, p.pos.Y + p.bottom, p.pos.Z) * rot)
end

track(RunService.Heartbeat:Connect(function(dt)
	if #pets == 0 then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local now = os.clock()

	if now - lastOwnClaim > 0.5 then
		lastOwnClaim = now
		claimOwnership()
	end

	local look = hrp.CFrame.LookVector
	local yaw = yawOf(Vector3.new(look.X, 0, look.Z))
	local flat = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)

	local wall = castWorld(hrp.Position, flat.LookVector * 9)
	tuck = tuck + ((wall and 1 or 0) - tuck) * math.clamp(dt * 6, 0, 1)

	local hum = char:FindFirstChildOfClass("Humanoid")
	local st = hum and hum:GetState()
	if st == Enum.HumanoidStateType.Jumping and lastPlayerState ~= Enum.HumanoidStateType.Jumping then
		for _, p in ipairs(pets) do
			if p.grounded and p.state == "follow" and not p.isYuji then
				p.hopAt = now + 0.12 * p.slot
			end
		end
	end
	lastPlayerState = st

	local hv = hrp.AssemblyLinearVelocity
	if Vector3.new(hv.X, 0, hv.Z).Magnitude > 1.5 or st == Enum.HumanoidStateType.Jumping then
		stillT = 0
	else
		stillT += dt
	end

	local ctx = {
		pos = hrp.Position,
		flat = flat,
		yaw = yaw,
		tuck = tuck,
		hrp = hrp,
		still = stillT,
		feetY = hrp.Position.Y - (hrp.Size.Y / 2) - (hum and hum.HipHeight or 2),
	}

	for _, p in ipairs(pets) do
		if p.model and p.model.Parent then
			if p.isYuji then
				stepYuji(p, dt, now, ctx)
			else
				stepPet(p, dt, now, ctx)
			end
		end
	end

	for _, p in ipairs(pets) do
		if p.model and p.model.Parent then
			fxUpdate(p)
			if p.hiddenState ~= hiddenAll or (hiddenAll and now - (p.hideAt or 0) > 1) then
				p.hiddenState = hiddenAll
				p.hideAt = now
				for _, d in ipairs(p.model:GetDescendants()) do
					if d:IsA("BasePart") then d.LocalTransparencyModifier = hiddenAll and 1 or 0 end
				end
			end
		end
	end

	if hum and hum.Health > 0 and hum.MaxHealth > 0
		and hum.Health / hum.MaxHealth <= CONFIG.LowHpFrac and now >= lowHpNext then
		lowHpNext = now + CONFIG.LowHpGap
		local alive = {}
		for _, p in ipairs(pets) do
			if p.model and p.model.Parent and p.state ~= "ko" then table.insert(alive, p) end
		end
		if #alive > 0 then
			local p = alive[math.random(1, #alive)]
			local lines = LOW_HP[p.kind]
			if lines then say(p, pick(lines)) end
			if not p.isYuji then playFor(p, "alert", 0.8) end
		end
	end
end))


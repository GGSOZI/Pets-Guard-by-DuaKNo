	local cands = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root and not d.Anchored then
			local role = limbRole(d)
			if role then cands[d] = role end
		end
	end

	local hasLegs = false
	for _, role in pairs(cands) do
		if role == "leg" or role == "arm" then hasLegs = true break end
	end
	if not hasLegs then
		for part in pairs(partJoints) do
			if part ~= root and not part.Anchored and not cands[part] and part.Transparency < 0.99 then
				local n = part.Name:lower()
				if not n:find("head", 1, true) and not n:find("tail", 1, true) then
					local ex, _, ez = halfExtents(part)
					local rel = (part.Position.Y - minV.Y) / height
					if rel < 0.4 and math.max(ex, ez) * 2 < length * 0.45 then
						cands[part] = "leg"
					end
				end
			end
		end
	end

	local limbs = {}
	for part, role in pairs(cands) do
		local joint, other
		for _, j in ipairs(partJoints[part] or {}) do
			local o = (j.Part0 == part) and j.Part1 or j.Part0
			if o and not cands[o] then
				joint, other = j, o
				break
			end
		end
		if joint then
			local motor
			if joint:IsA("Motor6D") and joint.Part1 == part then
				motor = joint
			else
				local c = part.Position
				local ex, ey, ez = halfExtents(part)
				local pivotPoint
				if role == "tail" then
					local toBody = Vector3.new(center.X - c.X, 0, center.Z - c.Z)
					if toBody.Magnitude > 0.01 then
						pivotPoint = c + toBody.Unit * math.min(math.max(ex, ez), toBody.Magnitude)
					else
						pivotPoint = c
					end
				else
					pivotPoint = Vector3.new(c.X, c.Y + ey, c.Z)
				end
				local pivotCF = CFrame.new(pivotPoint) * (part.CFrame - part.CFrame.Position)
				local mt = Instance.new("Motor6D")
				mt.Name = "ProcJoint"
				mt.Part0 = other
				mt.Part1 = part
				mt.C0 = other.CFrame:ToObjectSpace(pivotCF)
				mt.C1 = part.CFrame:ToObjectSpace(pivotCF)
				joint:Destroy()
				mt.Parent = other
				motor = mt
			end

			local worldAxis = (role == "tail") and Vector3.new(0, 1, 0) or right
			local axis = motor.C0:VectorToObjectSpace(motor.Part0.CFrame:VectorToObjectSpace(worldAxis))
			if axis.Magnitude > 0.001 then
				local rel = part.Position - center
				local fa, sa = rel:Dot(fvec), rel:Dot(right)
				local phase
				if math.abs(fa) > small then
					phase = ((fa > 0) == (sa > 0)) and 0 or math.pi
				else
					phase = (sa > 0) and 0 or math.pi
				end
				if role == "arm" and math.abs(fa) <= small then phase += math.pi end
				if role == "tail" then phase = 0 end
				table.insert(limbs, {
					joint = motor,
					axis = axis.Unit,
					phase = phase,
					role = role,
					fwd = (math.abs(fa) > small) and (fa > 0 and 1 or -1) or 0,
				})
			end
		end
	end
	return limbs
end

local function animateLimbs(p, now, dt, speed)
	local targetAmp = p.grounded and math.clamp(speed / 12, 0, 1) or 0
	p.amp = p.amp + (targetAmp - p.amp) * math.clamp(dt * 10, 0, 1)
	local targetAir = p.grounded and 0 or 1
	p.air = p.air + (targetAir - p.air) * math.clamp(dt * 14, 0, 1)
	p.gaitT = p.gaitT + dt * (5 + speed * 0.45)
	for _, L in ipairs(p.limbs) do
		local ang
		if L.role == "tail" then
			ang = math.sin(now * 7) * 0.45 * (0.35 + p.amp)
		else
			ang = math.sin(p.gaitT + L.phase) * 0.8 * p.amp * (1 - p.air) + L.fwd * 0.7 * p.air
		end
		pcall(function() L.joint.Transform = CFrame.fromAxisAngle(L.axis, ang) end)
	end
	return math.abs(math.sin(p.gaitT)) * 0.12 * p.amp
end


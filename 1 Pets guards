local function classifyAnimations(list)
	local out = {}
	for _, a in ipairs(list) do
		local matched = false
		for _, kv in ipairs(ANIM_KEYS) do
			if not out[kv[1]] then
				for _, pat in ipairs(kv[2]) do
					if a.label:find(pat, 1, true) then
						out[kv[1]] = a.id
						matched = true
						break
					end
				end
			end
			if matched then break end
		end
	end
	if next(out) == nil and #list > 0 then
		out.idle = list[1].id
		out.walk = (list[2] or list[1]).id
	end
	return out
end

local function makeTracks(animator, ids)
	local tracks = {}
	for key, id in pairs(ids) do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, t = pcall(function() return animator:LoadAnimation(a) end)
		if ok and t then
			t.Looped = (key == "idle" or key == "walk" or key == "run" or key == "fall")
			if key == "idle" then
				t.Priority = Enum.AnimationPriority.Idle
			elseif key == "attack" then
				t.Priority = Enum.AnimationPriority.Action
			else
				t.Priority = Enum.AnimationPriority.Movement
			end
			tracks[key] = t
		end
	end
	task.delay(2.5, function()
		for key, t in pairs(tracks) do
			local ok, len = pcall(function() return t.Length end)
			if ok and len == 0 then tracks[key] = nil end
		end
	end)
	return tracks
end

local function setAnim(p, key)
	local t = p.tracks[key]
	if not t then
		if key == "run" then t = p.tracks.walk
		elseif key == "jump" then t = p.tracks.fall end
	end
	if p.curTrack == t and p.curKey == key then return end
	if p.curTrack and p.curTrack ~= t then p.curTrack:Stop(0.2) end
	if t and p.curTrack ~= t then t:Play(0.2) end
	p.curTrack, p.curKey = t, key
end

local LEG_PAT = { "leg", "paw", "foot", "feet", "thigh", "calf", "shin", "hip" }
local ARM_PAT = { "arm", "hand", "shoulder" }

local function matchAny(name, pats)
	for _, pt in ipairs(pats) do
		if name:find(pt, 1, true) then return true end
	end
	return false
end

local function limbRole(part)
	local n = part.Name:lower()
	if n:find("tail", 1, true) then return "tail" end
	if n:find("armor", 1, true) then return nil end
	if matchAny(n, ARM_PAT) then return "arm" end
	if matchAny(n, LEG_PAT) then return "leg" end
	return nil
end

local function halfExtents(part)
	local cf, s = part.CFrame, part.Size
	local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
	local ex = (math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z) / 2
	local ey = (math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z) / 2
	local ez = (math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z) / 2
	return ex, ey, ez
end


local function makeCmdTool()
	local t = Instance.new("Tool")
	t.Name = "Pet commands"
	t.ToolTip = "Equip to open the pet command panel"
	t.RequiresHandle = false
	t.CanBeDropped = false
	buildCmdGui()
	t.Equipped:Connect(function()
		if ui.gui then ui.gui.Enabled = true end
	end)
	t.Unequipped:Connect(function()
		if ui.gui then
			ui.gui.Enabled = false
			if ui.closeSwap then ui.closeSwap() end
		end
	end)
	t.Destroying:Connect(function()
		if ui.gui then ui.gui.Enabled = false end
	end)
	return t
end

local function makeTool(name, tip, callback)
	local t = Instance.new("Tool")
	t.Name = name
	t.ToolTip = tip
	t.RequiresHandle = false
	t.CanBeDropped = false
	local debounce = false
	t.Activated:Connect(function()
		if debounce then return end
		debounce = true
		task.spawn(callback)
		task.delay(0.5, function() debounce = false end)
	end)
	return t
end

local function clearTools()
	for _, t in ipairs(tools) do
		pcall(function() t:Destroy() end)
	end
	tools = {}
end

local function giveTools()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack", 5)
	if not bp then return end
	clearTools()
	local guard = makeTool("Dogs and Cats Guard", "Spawn a random pet guard", function()
		if spawning then return end
		spawning = true
		local ok, err = pcall(spawnPet)
		spawning = false
		if not ok then warn("[Guard] " .. tostring(err)) end
	end)
	local recall = makeTool("Recall", "Send your oldest pet away", recallPet)
	local cmdTool = makeCmdTool()
	guard.Parent = bp
	recall.Parent = bp
	cmdTool.Parent = bp
	tools = { guard, recall, cmdTool }
end

